    "Nothing needs your attention.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Nichts erfordert Ihre Aufmerksamkeit."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No hay nada que requiera su atención."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Rien ne requiert votre attention."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Non c’è nulla che richieda la tua attenzione."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "対応が必要なものはありません。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Nada precisa da sua atenção."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "没有需要处理的事项。"
          }
        }
      }
