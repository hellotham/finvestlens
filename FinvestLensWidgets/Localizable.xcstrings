    "Bills due, over-budget spending and other alerts.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Fällige Rechnungen, Budgetüberschreitungen und andere Warnungen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Facturas pendientes, gastos por encima del presupuesto y otros avisos."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Factures à payer, dépassements de budget et autres alertes."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Fatture in scadenza, spese oltre budget e altri avvisi."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "支払期日の請求、予算超過の支出、その他の通知。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Contas a vencer, gastos acima do orçamento e outros alertas."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "到期账单、超预算支出及其他提醒。"
          }
        }
