    "A minimum payment doesn't cover its debt's interest — it never pays off.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Eine Mindestzahlung deckt die Zinsen der Schuld nicht — sie wird nie getilgt."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Un pago mínimo no cubre los intereses de su deuda: nunca se amortiza."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Un paiement minimum ne couvre pas les intérêts de la dette — elle ne sera jamais remboursée."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Un pagamento minimo non copre gli interessi del debito: non si estinguerà mai."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "最低支払額が債務の利息を下回っています。完済できません。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Um pagamento mínimo não cobre os juros da dívida — ela nunca será quitada."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "最低还款额不足以支付该债务的利息 — 永远无法还清。"
          }
        }
      }
    },
    "A one-page snapshot for sharing — net worth, trend, assets, income, savings rate (FR-PLAN-17)": {
      "extractionState": "manual",
      "localizations": {
        "de": {
