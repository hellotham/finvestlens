    "File ▸ Export CSV, on the Mac, writes plain spreadsheet files — your accounts, your transactions, or your price history — for anything that reads a table.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ablage ▸ CSV exportieren schreibt auf dem Mac einfache Tabellendateien — Ihre Konten, Ihre Buchungen oder Ihre Kurshistorie — für alles, was eine Tabelle liest."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Archivo ▸ Exportar CSV, en el Mac, escribe hojas de cálculo sencillas — sus cuentas, sus transacciones o su histórico de cotizaciones — para cualquier cosa que lea una tabla."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Fichier ▸ Exporter en CSV, sur le Mac, écrit de simples fichiers tableur — vos comptes, vos opérations ou votre historique de cours — pour tout ce qui lit un tableau."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Archivio ▸ Esporta CSV, sul Mac, scrive semplici fogli di calcolo — i vostri conti, le vostre transazioni o lo storico quotazioni — per qualunque cosa legga una tabella."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Mac では、ファイル ▸ CSV を書き出す で素朴な表計算ファイル（勘定科目、取引、価格履歴）を書き出せます。表を読めるものなら何にでも渡せます。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Arquivo ▸ Exportar CSV, no Mac, grava planilhas simples — suas contas, suas transações ou seu histórico de cotações — para qualquer coisa que leia uma tabela."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在 Mac 上，“文件 ▸ 导出 CSV”会写出朴素的表格文件——你的科目、你的交易，或价格历史——供任何能读表格的工具使用。"
          }
        }
      }
    },
    "File ▸ Export Ledger Journal… (⇧⌘E) writes a plain-text Ledger journal, and File ▸ Import Ledger Journal… reads one back.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ablage ▸ Ledger-Journal exportieren… (⇧⌘E) schreibt ein Ledger-Journal als reinen Text, und Ablage ▸ Ledger-Journal importieren… liest eines wieder ein."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Archivo ▸ Exportar diario Ledger… (⇧⌘E) escribe un diario Ledger en texto plano, y Archivo ▸ Importar diario Ledger… vuelve a leerlo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Fichier ▸ Exporter le journal Ledger… (⇧⌘E) écrit un journal Ledger en texte brut, et Fichier ▸ Importer le journal Ledger… le relit."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Archivio ▸ Esporta giornale Ledger… (⇧⌘E) scrive un giornale Ledger in testo semplice, e Archivio ▸ Importa giornale Ledger… lo rilegge."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ファイル ▸ Ledger ジャーナルを書き出す… (⇧⌘E) はプレーンテキストの Ledger ジャーナルを書き出し、ファイル ▸ Ledger ジャーナルを読み込む… はそれを読み戻します。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Arquivo ▸ Exportar diário Ledger… (⇧⌘E) grava um diário Ledger em texto puro, e Arquivo ▸ Importar diário Ledger… o lê de volta."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "“文件 ▸ 导出 Ledger 日记账…”(⇧⌘E) 会写出纯文本的 Ledger 日记账，“文件 ▸ 导入 Ledger 日记账…”则可将其读回。"
          }
        }
      }
    },
    "Fill from recent…": {
