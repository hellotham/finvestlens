    "Set aside part of an account toward a target — a holiday, an emergency fund, a deposit.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Einen Teil eines Kontos für ein Ziel zurücklegen — einen Urlaub, einen Notgroschen, eine Anzahlung."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Reserva parte de una cuenta para un objetivo: unas vacaciones, un fondo de emergencia, una entrada."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Mettez de côté une partie d’un compte pour un objectif — des vacances, un fonds d’urgence, un apport."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Metti da parte una quota di un conto per un obiettivo: una vacanza, un fondo d’emergenza, un acconto."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "口座の一部を目標のために取り分けます — 旅行、緊急資金、頭金など。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Reserve parte de uma conta para um objetivo — uma viagem, um fundo de emergência, uma entrada."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "从某个科目中预留一部分资金用于目标 — 度假、应急金、首付。"
          }
        }
      }
    },
    "Set date to invoice date (%@) — the bank’s date is kept for matching": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Datum auf das Rechnungsdatum (%@) setzen — das Bankdatum bleibt für den Abgleich erhalten"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Fijar la fecha en la de la factura (%@): se conserva la fecha del banco para el emparejamiento"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Fixer la date à celle de la facture (%@) — la date de la banque est conservée pour l’appariement"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Imposta la data a quella della fattura (%@): la data della banca resta per l’abbinamento"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "日付を請求書の日付 (%@) に設定します。照合用に銀行の日付は保持されます"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Definir a data como a da fatura (%@) — a data do banco é mantida para correspondência"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "将日期设为发票日期（%@） — 银行日期保留用于匹配"
          }
        }
      }
    },
    "Set money aside toward something, and track the push.": {
      "extractionState": "manual",
