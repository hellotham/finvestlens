          "stringUnit": {
            "state": "translated",
            "value": "Montants supérieurs (ou `<` inférieurs) à un chiffre."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Importi superiori (o `<` inferiori) a una cifra."
          }
        },
        "ja": {
