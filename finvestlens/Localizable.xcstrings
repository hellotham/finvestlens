    "Type into the **Tags** line, separating tags with commas.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Tippen Sie in die Zeile **Tags** und trennen Sie Tags durch Kommas."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Escriba en la línea **Etiquetas**, separando las etiquetas con comas."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Saisissez dans la ligne **Tags**, en séparant les tags par des virgules."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Scrivete nella riga **Tag**, separandoli con virgole."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "**タグ**行に入力します。タグはカンマで区切ります。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Digite na linha **Etiquetas**, separando as etiquetas por vírgulas."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在**标签**行中输入，标签之间用逗号分隔。"
          }
        }
      }
    },
