    "Price update: added %lld, %lld failed — see Prices for details.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Kursaktualisierung: %1$lld hinzugefügt, %2$lld fehlgeschlagen – Details unter „Kurse“."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Actualización de cotizaciones: %1$lld añadidas, %2$lld con errores; consulte Cotizaciones."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Mise à jour des cours : %1$lld ajoutés, %2$lld en échec – voir Cours."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Aggiornamento quotazioni: %1$lld aggiunte, %2$lld non riuscite – vedi Quotazioni."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "価格更新: %1$lld 件を追加、%2$lld 件が失敗しました。詳細は「価格」をご覧ください。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Atualização de cotações: %1$lld adicionadas, %2$lld com falha — veja Cotações."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "价格更新：已添加 %1$lld 项，%2$lld 项失败 — 详见“价格”。"
          }
        }
      }
    },
    "Price-provider API keys — EODHD, Alpha Vantage, Finnhub, Twelve Data — are managed in Settings ▸ Pricing (⌘,). Yahoo and Stooq need no key.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "API-Schlüssel der Kursanbieter — EODHD, Alpha Vantage, Finnhub, Twelve Data — werden unter „Einstellungen ▸ Kurse“ (⌘,) verwaltet. Yahoo und Stooq benötigen keinen Schlüssel."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las claves de API de los proveedores de cotizaciones —EODHD, Alpha Vantage, Finnhub, Twelve Data— se gestionan en Ajustes ▸ Cotizaciones (⌘,). Yahoo y Stooq no necesitan clave."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les clés d’API des fournisseurs de cours — EODHD, Alpha Vantage, Finnhub, Twelve Data — se gèrent dans Réglages ▸ Cours (⌘,). Yahoo et Stooq n’exigent aucune clé."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Le chiavi API dei fornitori di quotazioni — EODHD, Alpha Vantage, Finnhub, Twelve Data — si gestiscono in Impostazioni ▸ Quotazioni (⌘,). Yahoo e Stooq non richiedono chiavi."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "価格プロバイダの API キー（EODHD、Alpha Vantage、Finnhub、Twelve Data）は「設定 ▸ 価格」(⌘,) で管理します。Yahoo と Stooq にキーは不要です。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "As chaves de API dos provedores de cotações — EODHD, Alpha Vantage, Finnhub, Twelve Data — são gerenciadas em Ajustes ▸ Cotações (⌘,). Yahoo e Stooq não exigem chave."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "价格数据源的 API 密钥 — EODHD、Alpha Vantage、Finnhub、Twelve Data — 在「设置 ▸ 价格」(⌘,) 中管理。Yahoo 与 Stooq 无需密钥。"
          }
        }
      }
    },
