    "These scheduled transactions use formulas (FR-SCH-02). Enter the amounts for each variable; they apply to every instance posted now.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Diese geplanten Buchungen verwenden Formeln. Geben Sie die Beträge für jede Variable ein; sie gelten für alle jetzt gebuchten Vorkommen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Estas transacciones programadas usan fórmulas. Introduce los importes de cada variable; se aplican a todas las instancias que se contabilicen ahora."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ces opérations planifiées utilisent des formules. Saisissez les montants de chaque variable ; ils s’appliquent à toutes les occurrences comptabilisées maintenant."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Queste transazioni pianificate usano formule. Inserisci gli importi per ogni variabile; si applicano a tutte le occorrenze registrate ora."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "これらの予定取引は数式を使用します。各変数の金額を入力してください。今回記帳されるすべての回に適用されます。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Estas transações programadas usam fórmulas. Informe os valores de cada variável; eles se aplicam a todas as ocorrências lançadas agora."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这些预定交易使用公式。请为每个变量输入金额；它们将应用于此次过账的所有实例。"
          }
        }
      }
    },
