    "The **Financial Year Pack** gathers the statements you need at tax time into one PDF, in reading order.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das **Jahresabschlusspaket** bündelt die zur Steuerzeit nötigen Abschlüsse in einem PDF, in Lesereihenfolge."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El **paquete de fin de ejercicio** reúne en un solo PDF, en orden de lectura, los estados que necesitas al hacer impuestos."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le **dossier de fin d’exercice** rassemble dans un seul PDF, dans l’ordre de lecture, les états dont vous avez besoin au moment des impôts."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il **pacchetto di fine esercizio** raccoglie in un unico PDF, in ordine di lettura, i bilanci che ti servono al momento delle imposte."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "**会計年度パック** は、確定申告に必要な財務諸表を読む順に 1 本の PDF にまとめます。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O **pacote de fim de exercício** reúne em um único PDF, na ordem de leitura, as demonstrações necessárias na época dos impostos."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "**财年资料包** 会将报税时所需的报表按阅读顺序汇成一份 PDF。"
          }
        }
      }
    },
    "The Loan Calculator builds a repayment schedule and can create the scheduled payment for you, split into interest and principal.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Darlehensrechner erstellt einen Tilgungsplan und kann die geplante Zahlung für Sie anlegen, aufgeteilt in Zinsen und Tilgung."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La calculadora de préstamos construye un cuadro de amortización y puede crear el pago programado por ti, desglosado en intereses y principal."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La calculatrice de prêt établit un tableau d’amortissement et peut créer le paiement planifié à votre place, réparti entre intérêts et capital."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La calcolatrice prestiti crea un piano di ammortamento e può generare il pagamento pianificato, suddiviso in interessi e capitale."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ローン計算機は返済表を作成し、利息と元本に分けた予定支払いを自動で作成できます。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A calculadora de empréstimo monta uma tabela de amortização e pode criar o pagamento programado para você, dividido em juros e principal."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "贷款计算器会生成还款计划表，并可为你创建预定付款，拆分为利息与本金。"
          }
        }
      }
    },
    "The book as a Ledger journal.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das Buch als Ledger-Journal."
