    "Put `-` in front of any term to exclude it — `-tag:work` hides work spending.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ein vorangestelltes `-` schließt einen Ausdruck aus — `-tag:work` blendet berufliche Ausgaben aus."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Antepón `-` a cualquier término para excluirlo: `-tag:work` oculta el gasto de trabajo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Préfixez un terme par `-` pour l’exclure — `-tag:work` masque les dépenses professionnelles."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Anteponi `-` a un termine per escluderlo: `-tag:work` nasconde le spese di lavoro."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "語の先頭に `-` を付けると除外できます。`-tag:work` は仕事の支出を隠します。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Prefixe qualquer termo com `-` para excluí-lo — `-tag:work` oculta gastos de trabalho."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在任意条件前加 `-` 即可排除 — `-tag:work` 会隐藏工作支出。"
          }
        }
      }
    },
