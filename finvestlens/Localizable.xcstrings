    "What the issuer declared per unit. What your book recorded is under Your transactions.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Was der Emittent je Einheit erklärt hat. Was Ihr Buch erfasst hat, steht unter „Ihre Buchungen“."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Lo que el emisor declaró por unidad. Lo que registró tu libro está en «Tus operaciones»."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ce que l’émetteur a déclaré par unité. Ce que votre livre a enregistré figure sous « Vos opérations »."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Quanto ha dichiarato l’emittente per unità. Ciò che ha registrato il tuo libro è in «Le tue operazioni»."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "発行体が 1 口あたりに宣言した額です。帳簿に記録された額は「あなたの取引」にあります。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O que o emissor declarou por unidade. O que o seu livro registrou está em “Suas operações”."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "发行人按每单位宣派的金额。你的账簿记录的金额在“你的交易”中。"
          }
        }
      }
    },
