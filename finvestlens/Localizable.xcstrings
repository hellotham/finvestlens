          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Joignez des fichiers aux opérations et gardez les liens fonctionnels."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Allega file alle transazioni e mantieni i collegamenti funzionanti."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
