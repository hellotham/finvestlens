    "Enter both amounts: what was taken out, and what was received.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Geben Sie beide Beträge ein: was abgebucht und was empfangen wurde."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Introduzca ambos importes: lo que se retiró y lo que se recibió."
          }
        },
        "fr": {
