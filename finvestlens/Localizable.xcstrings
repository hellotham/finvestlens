    "Bank statements, dividend statements and invoices are read on-device by Apple Intelligence and turned into transactions to review — nothing leaves your Mac.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Kontoauszüge, Dividendenabrechnungen und Rechnungen werden von Apple Intelligence auf dem Gerät gelesen und in Buchungen zur Prüfung umgewandelt — nichts verlässt Ihren Mac."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los extractos bancarios, los informes de dividendos y las facturas los lee Apple Intelligence en el propio dispositivo y los convierte en transacciones para revisar: nada sale de tu Mac."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les relevés bancaires, avis de dividendes et factures sont lus sur l’appareil par Apple Intelligence et transformés en opérations à vérifier — rien ne quitte votre Mac."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Estratti conto, avvisi di dividendo e fatture vengono letti sul dispositivo da Apple Intelligence e trasformati in transazioni da rivedere: nulla esce dal tuo Mac."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "銀行明細、配当通知、請求書は Apple Intelligence がデバイス上で読み取り、確認用の取引に変換します。データが Mac から出ることはありません。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Extratos bancários, avisos de dividendos e faturas são lidos no dispositivo pela Apple Intelligence e convertidos em transações para revisão — nada sai do seu Mac."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "银行对账单、股息通知和发票由 Apple 智能在设备端读取并转换为待审阅的交易 — 数据不会离开你的 Mac。"
          }
        }
      }
    },
