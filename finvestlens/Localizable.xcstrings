    "Attach a receipt or invoice to a transaction and it appears here.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Hängen Sie einen Beleg oder eine Rechnung an eine Buchung an, dann erscheint sie hier."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Adjunta un recibo o una factura a una transacción y aparecerá aquí."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Joignez un reçu ou une facture à une opération : il apparaîtra ici."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Allega una ricevuta o una fattura a una transazione e comparirà qui."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "領収書や請求書を取引に添付すると、ここに表示されます。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
