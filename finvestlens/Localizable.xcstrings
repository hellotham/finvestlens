    "Enabled fields apply uniformly to all %lld selected transaction%@; everything else is kept as it is.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Aktivierte Felder gelten einheitlich für alle %lld ausgewählten Buchungen%@; alles andere bleibt unverändert."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los campos activados se aplican por igual a las %lld transaccion%@ seleccionadas; todo lo demás se mantiene."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les champs activés s’appliquent uniformément aux %lld opération%@ sélectionnée%@ ; le reste est conservé tel quel."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "I campi attivati si applicano in modo uniforme a tutte le %lld transazion%@ selezionate; il resto resta invariato."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "有効にした項目は、選択した %lld 件の取引%@すべてに一律で適用されます。それ以外はそのまま保持されます。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Os campos ativados se aplicam igualmente a todas as %lld transaç%@ selecionadas; o restante é mantido."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "已启用的字段将统一应用于所选的全部 %lld 笔交易%@；其余内容保持不变。"
