    "Log billable hours or travel, then gather them onto a customer invoice.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Abrechenbare Stunden oder Fahrten erfassen und auf einer Kundenrechnung zusammenführen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Registra horas facturables o desplazamientos y agrúpalos en una factura de cliente."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Enregistrez les heures facturables ou les déplacements, puis regroupez-les sur une facture client."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Registra ore fatturabili o trasferte, poi raccoglile in una fattura al cliente."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "請求対象の作業時間や移動を記録し、顧客請求書にまとめます。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Registre horas faturáveis ou deslocamentos e reúna-os em uma fatura ao cliente."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "记录可计费工时或差旅，然后汇总到客户发票上。"
          }
        }
      }
    },
    "Look one up by name — the exchange and identifier are filled in for you": {
      "extractionState": "manual",
      "localizations": {
        "de": {
