    "Business ▸ Customers, Vendors & Invoices… (⇧⌘B) opens the business hub: customers, vendors, employees, jobs, invoices, bills and billing terms.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Geschäft ▸ Kunden, Lieferanten & Rechnungen … (⇧⌘B) öffnet den Geschäftsbereich: Kunden, Lieferanten, Mitarbeiter, Aufträge, Rechnungen, Eingangsrechnungen und Zahlungsbedingungen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Empresa ▸ Clientes, proveedores y facturas… (⇧⌘B) abre el centro de empresa: clientes, proveedores, empleados, trabajos, facturas emitidas y recibidas y condiciones de pago."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Entreprise ▸ Clients, fournisseurs et factures… (⇧⌘B) ouvre l’espace entreprise : clients, fournisseurs, employés, missions, factures clients et fournisseurs, conditions de règlement."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Azienda ▸ Clienti, fornitori e fatture… (⇧⌘B) apre l’area aziendale: clienti, fornitori, dipendenti, commesse, fatture attive e passive e termini di pagamento."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "「ビジネス ▸ 顧客・仕入先・請求書…」(⇧⌘B) でビジネスハブが開きます。顧客、仕入先、従業員、案件、請求書、支払請求、支払条件を扱えます。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Empresa ▸ Clientes, fornecedores e faturas… (⇧⌘B) abre a central de negócios: clientes, fornecedores, funcionários, trabalhos, faturas, contas e condições de pagamento."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "「企业 ▸ 客户、供应商与发票…」（⇧⌘B）打开企业中心：客户、供应商、员工、项目、应收与应付发票，以及付款条件。"
          }
        }
      }
    },
