            "plural": {
              "one": {
                "stringUnit": {
                  "state": "translated",
                  "value": "Si applica al %lld trasferimento semplice: le transazioni con più suddivisioni, su titoli e multivaluta restano invariate."
                }
              },
              "other": {
                "stringUnit": {
                  "state": "translated",
                  "value": "Si applica ai %lld trasferimenti semplici: le transazioni con più suddivisioni, su titoli e multivaluta restano invariate."
                }
              }
            }
          }
        },
        "ja": {
