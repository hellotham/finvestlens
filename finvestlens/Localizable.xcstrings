            "state": "translated",
            "value": "No hay ningún saldo que cerrar a esta fecha."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Aucun solde à clôturer à cette date."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Nessun saldo da chiudere a questa data."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "この日付で締め切る残高はありません。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Não há saldo a encerrar nesta data."
          }
        },
