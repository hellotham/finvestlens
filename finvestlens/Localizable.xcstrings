    "Rows nothing categorised still import, parked in Imbalance for the Uncategorised review to sweep": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Nicht kategorisierte Zeilen werden dennoch importiert und im Ausgleichskonto geparkt, damit die Prüfung „Nicht kategorisiert“ sie aufgreift"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las filas que no se categorizan se importan igualmente y quedan en la cuenta de descuadre para que las recoja la revisión de «Sin categoría»"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les lignes non catégorisées sont tout de même importées et placées dans le compte de déséquilibre, pour être reprises par la revue « Non catégorisées »"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Le righe non categorizzate vengono comunque importate e parcheggiate nel conto di sbilancio, così la revisione «Non categorizzate» le raccoglie"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "分類されなかった行もインポートされ、不均衡勘定に置かれます。「未分類」レビューで処理できます"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "As linhas não categorizadas mesmo assim são importadas e ficam na conta de desequilíbrio, para a revisão «Sem categoria» recolhê-las"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "未被分类的行仍会导入，暂存于失衡科目，供「未分类」审阅统一处理"
          }
        }
      }
    },
    "Rows nothing could categorise still import — parked in Imbalance for the Uncategorised review to sweep up later.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Zeilen, die sich nicht kategorisieren ließen, werden dennoch importiert — geparkt im Ausgleichskonto, damit die Prüfung „Nicht kategorisiert“ sie später aufgreift."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las filas que no se pudieron categorizar se importan igualmente, aparcadas en la cuenta de descuadre para que la revisión de «Sin categoría» las recoja después."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les lignes qu’aucune règle n’a pu catégoriser sont tout de même importées — placées dans le compte de déséquilibre, pour être reprises plus tard par la revue « Non catégorisées »."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Le righe che non è stato possibile categorizzare vengono comunque importate, parcheggiate nel conto di sbilancio perché la revisione «Non categorizzate» le raccolga più tardi."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "分類できなかった行もインポートされ、不均衡勘定に置かれます。あとで「未分類」レビューからまとめて処理できます。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "As linhas que nada conseguiu categorizar mesmo assim são importadas — estacionadas na conta de desequilíbrio para a revisão «Sem categoria» recolher depois."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无法分类的行仍会导入 — 暂存于失衡科目，供之后的「未分类」审阅统一处理。"
          }
        }
      }
    },
    "Rows you have already imported are marked as duplicates and skipped.": {
