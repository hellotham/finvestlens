    "Missing days *inside a period you held something* are called out separately: those are the ones that make past valuations wrong.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Fehlende Tage *innerhalb einer Haltedauer* werden gesondert genannt: Genau sie machen frühere Bewertungen falsch."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Missing days *inside a period you held something* are called out separately: those are the ones that make past valuations wrong."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los días ausentes *dentro de un periodo en que tenías algo* se señalan aparte: son los que falsean las valoraciones pasadas."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les jours manquants *à l’intérieur d’une période de détention* sont signalés à part : ce sont eux qui faussent les valorisations passées."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "I giorni mancanti *all’interno di un periodo di possesso* sono segnalati a parte: sono quelli che falsano le valutazioni passate."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "*保有していた期間の中にある*欠落日は別に示されます。過去の評価額を誤らせるのはこれらだからです。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Dias ausentes *dentro de um período em que você tinha algo* são destacados à parte: são eles que tornam erradas as avaliações passadas."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "*持有期间内*的缺失日会单独指出：正是这些让过去的估值出错。"
          }
        }
      }
    },
