    "Assign categories to uncategorised transactions": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Nicht kategorisierten Buchungen Kategorien zuweisen"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Asignar categorías a las transacciones sin categoría"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Attribuer des catégories aux opérations non catégorisées"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Assegna categorie alle transazioni non categorizzate"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "未分類の取引にカテゴリを割り当てる"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Atribuir categorias às transações sem categoria"
          }
        },
