          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "将收据或发票附加到某笔交易后，会显示在此处。"
          }
        }
      }
    },
    "Attach files to transactions and keep the links working.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dateien an Buchungen anhängen und die Verknüpfungen funktionsfähig halten."
          }
        },
        "es": {
