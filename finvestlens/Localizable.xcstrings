    "Pick a page on the left, or search.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wählen Sie links eine Seite, oder suchen Sie."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Elige una página a la izquierda, o busca."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Choisissez une page à gauche, ou faites une recherche."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Scegli una pagina a sinistra, oppure cerca."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "左からページを選ぶか、検索してください。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Escolha uma página à esquerda ou use a busca."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在左侧选择一个页面，或使用搜索。"
          }
        }
      }
    },
    "Pick receipts, invoices or dividend statements (PDF or image). Each is matched to its transaction — in any account — then linked and categorised.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wählen Sie Belege, Rechnungen oder Dividendenabrechnungen (PDF oder Bild). Jede wird ihrer Buchung zugeordnet — in jedem Konto — und dann verknüpft und kategorisiert."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Elige recibos, facturas o informes de dividendos (PDF o imagen). Cada uno se empareja con su transacción —en cualquier cuenta— y luego se vincula y categoriza."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Choisissez des reçus, factures ou avis de dividende (PDF ou image). Chacun est associé à son opération — dans n’importe quel compte — puis lié et catégorisé."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Scegli ricevute, fatture o avvisi di dividendo (PDF o immagine). Ognuno viene abbinato alla sua transazione, in qualsiasi conto, poi collegato e categorizzato."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "領収書・請求書・配当通知（PDF または画像）を選びます。それぞれが（どの勘定科目でも）対応する取引に照合され、リンクと分類が行われます。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Escolha recibos, faturas ou avisos de dividendos (PDF ou imagem). Cada um é associado à sua transação — em qualquer conta — e depois vinculado e categorizado."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "选择收据、发票或股息通知（PDF 或图像）。每一项都会与其交易匹配 — 不限科目 — 然后完成关联与分类。"
          }
        }
      }
    },
    "Pick the account the money left and the account it arrived in.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wählen Sie das Konto, von dem das Geld abging, und das, auf dem es ankam."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Elija la cuenta de la que salió el dinero y aquella en la que llegó."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Choisissez le compte d’où l’argent est parti et celui où il est arrivé."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Scegliete il conto da cui il denaro è uscito e quello in cui è arrivato."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "お金が出ていった勘定科目と、届いた勘定科目を選びます。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Escolha a conta de onde o dinheiro saiu e aquela em que chegou."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "选择资金转出的科目与到账的科目。"
          }
        }
      }
    },
