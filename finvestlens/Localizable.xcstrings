    "Yahoo and Stooq need no key; EODHD, Alpha Vantage, Finnhub and Twelve Data take a free API key, set in Settings ▸ Pricing.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Yahoo und Stooq brauchen keinen Schlüssel; EODHD, Alpha Vantage, Finnhub und Twelve Data nehmen einen kostenlosen API-Schlüssel, den Sie unter Einstellungen ▸ Kurse eintragen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Yahoo y Stooq no necesitan clave; EODHD, Alpha Vantage, Finnhub y Twelve Data admiten una clave de API gratuita, que se configura en Ajustes ▸ Cotizaciones."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Yahoo et Stooq n’exigent aucune clé ; EODHD, Alpha Vantage, Finnhub et Twelve Data acceptent une clé d’API gratuite, à renseigner dans Réglages ▸ Cours."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Yahoo e Stooq non richiedono chiavi; EODHD, Alpha Vantage, Finnhub e Twelve Data accettano una chiave API gratuita, da impostare in Impostazioni ▸ Quotazioni."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Yahoo と Stooq はキー不要です。EODHD、Alpha Vantage、Finnhub、Twelve Data は無料の API キーを使い、「設定 ▸ 価格」で設定します。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Yahoo e Stooq não precisam de chave; EODHD, Alpha Vantage, Finnhub e Twelve Data aceitam uma chave de API gratuita, definida em Ajustes ▸ Cotações."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Yahoo 与 Stooq 无需密钥；EODHD、Alpha Vantage、Finnhub 与 Twelve Data 可使用免费 API 密钥，在「设置 ▸ 价格」中配置。"
          }
        }
      }
    },
