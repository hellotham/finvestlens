                  "state": "translated",
                  "value": "Aplica-se à %lld transferência simples — transações com várias divisões, de títulos e multimoeda não são alteradas."
                }
              },
              "other": {
                "stringUnit": {
                  "state": "translated",
                  "value": "Aplica-se às %lld transferências simples — transações com várias divisões, de títulos e multimoeda não são alteradas."
                }
              }
            }
          }
        },
        "zh-Hans": {
