    "Open the transaction editor with the document beside it — enter a new transaction, or link the document to an existing one": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Den Buchungseditor mit dem Dokument daneben öffnen — neue Buchung erfassen oder das Dokument mit einer vorhandenen verknüpfen"
          }
        },
        "es": {
          "stringUnit": {
