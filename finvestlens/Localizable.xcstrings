    "“%@” is empty and can be deleted.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "„%@“ ist leer und kann gelöscht werden."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "«%@» está vacía y se puede eliminar."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "« %@ » est vide et peut être supprimé."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "«%@» è vuoto e può essere eliminato."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "「%@」は空なので削除できます。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "«%@» está vazia e pode ser apagada."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "「%@」为空，可以删除。"
          }
        }
      }
    },
    "“%@” isn’t a currency code — use three letters like USD, or clear the cell.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "„%@“ ist kein Währungscode – drei Buchstaben wie USD verwenden oder das Feld leeren."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "«%@» no es un código de moneda: usa tres letras como USD o vacía la celda."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "« %@ » n’est pas un code de devise — utilisez trois lettres comme USD, ou videz la cellule."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "“%@” non è un codice valuta — usa tre lettere come USD, oppure svuota la cella."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "「%@」は通貨コードではありません。USD のような3文字を入力するか、セルを空にしてください。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "“%@” não é um código de moeda — use três letras como USD, ou limpe a célula."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "“%@”不是货币代码 — 请输入 USD 之类的三个字母，或清空该单元格。"
          }
        }
      }
    },
