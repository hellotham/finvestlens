        }
      }
    },
    "This security has no prices or transactions in this book.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Zu diesem Wertpapier gibt es in diesem Buch weder Kurse noch Buchungen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Este valor no tiene cotizaciones ni operaciones en este libro."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ce titre n’a ni cours ni opérations dans ce livre."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Questo titolo non ha quotazioni né operazioni in questo libro."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "この帳簿には、この証券の価格も取引もありません。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Este título não tem cotações nem operações neste livro."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此账簿中没有该证券的价格或交易。"
          }
        }
      }
    },
    "This security is no longer in the book.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dieses Wertpapier ist nicht mehr im Buch enthalten."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Este valor ya no está en el libro."
          }
        },
        "fr": {
