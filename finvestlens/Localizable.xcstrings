    "One PDF, in reading order — the income statement, statement of financial position, changes in net worth, realised gains, and dividends with franking credits.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ein PDF in Lesereihenfolge — Gewinn- und Verlustrechnung, Bilanz, Veränderung des Nettovermögens, realisierte Gewinne und Dividenden mit Steuergutschriften."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Un único PDF, en orden de lectura: estado de resultados, balance, variación del patrimonio neto, plusvalías realizadas y dividendos con créditos fiscales."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Un seul PDF, dans l’ordre de lecture — compte de résultat, bilan, variation de la valeur nette, plus-values réalisées et dividendes avec crédits d’impôt."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Un unico PDF, in ordine di lettura: conto economico, stato patrimoniale, variazione del patrimonio netto, plusvalenze realizzate e dividendi con crediti d’imposta."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "読む順に並べた 1 本の PDF — 損益計算書、貸借対照表、純資産の変動、実現益、そしてフランキングクレジット付きの配当。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Um único PDF, na ordem de leitura — demonstração de resultados, balanço patrimonial, variação do patrimônio líquido, ganhos realizados e dividendos com créditos fiscais."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "一份 PDF，按阅读顺序编排 — 利润表、财务状况表、净资产变动、已实现收益，以及含税收抵免的股息。"
          }
        }
      }
    },
