    "Autosave is off — changes are written only on Save (⌘S) or when closing the book.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Automatisches Sichern ist aus — Änderungen werden nur beim Sichern (⌘S) oder beim Schließen des Buchs geschrieben."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El autoguardado está desactivado: los cambios solo se escriben al guardar (⌘S) o al cerrar el libro."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L’enregistrement automatique est désactivé — les modifications ne sont écrites qu’avec ⌘S ou à la fermeture du livre."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La registrazione automatica è disattivata: le modifiche vengono scritte solo con ⌘S o alla chiusura del libro."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "自動保存はオフです。変更は保存 (⌘S) 時、または帳簿を閉じるときにのみ書き込まれます。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
