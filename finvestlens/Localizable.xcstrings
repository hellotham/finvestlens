    "Everything you can reach without the mouse.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Alles, was ohne Maus erreichbar ist."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Todo lo que puedes hacer sin el ratón."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tout ce qui est accessible sans la souris."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Tutto ciò che puoi fare senza il mouse."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "マウスを使わずに操作できること。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Tudo o que dá para fazer sem o mouse."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无需鼠标即可完成的操作。"
          }
        }
      }
    },
    "Everything you do is undoable with ⌘Z — including imports. If a change looks wrong, undo it rather than repairing it by hand.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Alles lässt sich mit ⌘Z widerrufen — auch Importe. Sieht eine Änderung falsch aus, widerrufen Sie sie, statt sie von Hand zu reparieren."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Todo se puede deshacer con ⌘Z, incluidas las importaciones. Si un cambio parece mal, deshazlo en lugar de arreglarlo a mano."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tout est annulable avec ⌘Z — y compris les imports. Si un changement semble erroné, annulez-le plutôt que de le corriger à la main."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Tutto è annullabile con ⌘Z, importazioni comprese. Se una modifica sembra sbagliata, annullala invece di ripararla a mano."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "すべての操作は ⌘Z で取り消せます（読み込みも含みます）。変更がおかしいと感じたら、手作業で直すより取り消してください。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Tudo pode ser desfeito com ⌘Z — inclusive importações. Se uma alteração parecer errada, desfaça em vez de consertar à mão."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "所有操作都可用 ⌘Z 撤销 — 包括导入。若某项更改看起来不对，请撤销它，而不是手工修补。"
          }
        }
      }
    },
