    "Type the date, then the description — earlier entries autocomplete as you type.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Tippen Sie das Datum, dann die Beschreibung — frühere Einträge werden beim Tippen vervollständigt."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Escribe la fecha y luego la descripción: las entradas anteriores se autocompletan mientras escribes."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Saisissez la date, puis le libellé — les saisies antérieures se complètent automatiquement."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Digita la data, poi la descrizione: le voci precedenti si completano automaticamente mentre scrivi."
