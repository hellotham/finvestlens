    "Press Space on a book in the Finder to see inside it without opening it — FinvestLens documents, and GnuCash files too, in all three shapes GnuCash writes them.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Drücken Sie im Finder die Leertaste auf einem Buch, um hineinzusehen, ohne es zu öffnen — FinvestLens-Dokumente und auch GnuCash-Dateien, in allen drei Formen, die GnuCash schreibt."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Pulse Espacio sobre un libro en el Finder para ver su interior sin abrirlo: documentos de FinvestLens y también archivos de GnuCash, en las tres formas en que GnuCash los escribe."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Appuyez sur Espace sur un livre dans le Finder pour en voir le contenu sans l’ouvrir — documents FinvestLens, et fichiers GnuCash aussi, dans les trois formes que GnuCash écrit."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Premete Spazio su un libro nel Finder per vederne il contenuto senza aprirlo: documenti FinvestLens e anche file GnuCash, in tutte e tre le forme in cui GnuCash li scrive."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Finder で帳簿を選んでスペースキーを押すと、開かずに中身を確認できます。FinvestLens の書類だけでなく、GnuCash が書き出す 3 種類すべての GnuCash ファイルにも対応します。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Pressione Espaço sobre um livro no Finder para ver seu conteúdo sem abri-lo — documentos do FinvestLens e também arquivos do GnuCash, nas três formas em que o GnuCash os grava."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在访达中选中账簿并按空格键，即可不打开而查看其内容——既支持 FinvestLens 文稿，也支持 GnuCash 文件的全部三种写入形式。"
          }
        }
      }
    },
    "Press ⌘⏎, or click away, to commit the row.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Drücken Sie ⌘⏎ oder klicken Sie weg, um die Zeile zu übernehmen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Pulse ⌘⏎, o haga clic fuera, para confirmar la fila."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Appuyez sur ⌘⏎, ou cliquez ailleurs, pour valider la ligne."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Premete ⌘⏎, o fate clic altrove, per confermare la riga."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "⌘⏎ を押すか、ほかの場所をクリックして行を確定します。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Pressione ⌘⏎, ou clique fora, para confirmar a linha."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "按 ⌘⏎ 或点击别处，以提交该行。"
          }
        }
      }
    },
    "Press ⎋ to discard the edit.": {
      "extractionState": "manual",
      "localizations": {
