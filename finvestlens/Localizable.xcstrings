          }
        }
      }
    },
    "A relative link that isn’t found under the document folder is also looked for here — useful for an archive folder, or the old location after moving documents.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ein relativer Link, der nicht im Dokumentordner gefunden wird, wird auch hier gesucht — nützlich für einen Archivordner oder den alten Ort nach dem Verschieben von Dokumenten."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Un enlace relativo que no se encuentre en la carpeta del documento también se buscará aquí: útil para una carpeta de archivo o la ubicación anterior tras mover documentos."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Un lien relatif introuvable dans le dossier du document est aussi recherché ici — utile pour un dossier d’archives ou l’ancien emplacement après un déplacement."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Un collegamento relativo non trovato nella cartella del documento viene cercato anche qui: utile per una cartella di archivio o per la posizione precedente dopo uno spostamento."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "書類フォルダ内に見つからない相対リンクは、ここも検索されます。アーカイブフォルダや、書類を移動する前の場所に便利です。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Um link relativo que não for encontrado na pasta do documento também será procurado aqui — útil para uma pasta de arquivo ou o local antigo após mover documentos."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在文稿文件夹下找不到的相对链接也会在此处查找 — 适用于存档文件夹，或移动文稿后的旧位置。"
          }
        }
      }
    },
    "A time-boxed savings push on one of your goals": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ein befristeter Sparschub für eines Ihrer Ziele"
          }
        },
        "es": {
