          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La réponse du fournisseur n’avait pas la forme attendue."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La risposta del fornitore non aveva la forma prevista."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "プロバイダの応答が想定した形式ではありませんでした。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A resposta do provedor não veio na forma esperada."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "提供方的回复不符合预期格式。"
          }
        }
      }
    },
    "The quick brown fox": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Franz jagt im Taxi"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El veloz murciélago hindú"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Portez ce vieux whisky"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Ma la volpe col suo balzo"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "あのイーハトーヴォの"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
