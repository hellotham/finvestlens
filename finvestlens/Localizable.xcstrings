    "Record Dividend… books the cash and, where it applies, the franking credits — so the tax reports have what they need at the end of the year.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dividende erfassen … bucht die Barzahlung und, wo zutreffend, die Steuergutschriften — damit die Steuerberichte am Jahresende alles Nötige haben."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Registrar dividendo… contabiliza el efectivo y, cuando corresponde, los créditos fiscales, para que los informes fiscales tengan lo que necesitan a fin de año."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Enregistrer un dividende… comptabilise le montant en espèces et, le cas échéant, les crédits d’impôt — afin que les rapports fiscaux disposent du nécessaire en fin d’année."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Registra dividendo… contabilizza la parte in contanti e, dove previsto, i crediti d’imposta, così i resoconti fiscali hanno ciò che serve a fine anno."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "「配当を記録…」は現金分と、該当する場合はフランキングクレジットも記帳します。これにより年度末の税務レポートに必要な情報が揃います。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Registrar dividendo… lança o valor em dinheiro e, quando aplicável, os créditos fiscais — assim os relatórios fiscais têm o que precisam no fim do ano."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "「记录股息…」会记入现金部分，并在适用时记入税收抵免 — 使年末的税务报表具备所需数据。"
          }
        }
      }
    },
