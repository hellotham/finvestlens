            "state": "translated",
            "value": "天地玄黄 宇宙洪荒"
          }
        }
      }
    },
    "The register, splits, and editing a row in place.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das Kontobuch, Buchungsteile und das Bearbeiten einer Zeile an Ort und Stelle."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El registro, los desgloses y la edición de una fila en su sitio."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le registre, les répartitions et la modification d’une ligne sur place."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il registro, le suddivisioni e la modifica di una riga sul posto."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "記録簿、分割、そして行をその場で編集すること。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O registro, as divisões e a edição de uma linha no próprio lugar."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "账簿、分录，以及就地编辑某一行。"
          }
        }
      }
    },
    "The review screen": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Prüfbildschirm"
          }
        },
        "es": {
