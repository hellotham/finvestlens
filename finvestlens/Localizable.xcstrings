    "Emergency Records": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Notfallunterlagen"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Registros de emergencia"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Fiches d’urgence"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Documenti d’emergenza"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "緊急時記録"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Registros de emergência"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "应急记录"
          }
        }
      }
    },
    "Emergency Records keeps the details someone would need in a hurry — insurance policies, account numbers, contacts — alongside the book rather than scattered across notes and drawers.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Notfallunterlagen bewahrt die Angaben, die jemand in Eile bräuchte — Versicherungspolicen, Kontonummern, Kontakte — beim Buch statt verstreut in Notizen und Schubladen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Registros de emergencia guarda los datos que alguien necesitaría con urgencia —pólizas de seguro, números de cuenta, contactos— junto al libro, en lugar de dispersos en notas y cajones."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Fiches d’urgence conserve les informations dont on aurait besoin dans l’urgence — polices d’assurance, numéros de compte, contacts — avec le livre plutôt qu’éparpillées dans des notes et des tiroirs."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Documenti d’emergenza conserva le informazioni che servirebbero in fretta — polizze, numeri di conto, contatti — accanto al libro invece che sparse tra appunti e cassetti."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "「緊急時記録」は、いざというときに必要な情報（保険証券、口座番号、連絡先）を、メモや引き出しに散らばらせず帳簿と一緒に保管します。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Registros de emergência guarda as informações que alguém precisaria com urgência — apólices, números de conta, contatos — junto ao livro, em vez de espalhadas em anotações e gavetas."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "「应急记录」把急需时会用到的信息 — 保单、账号、联系人 — 与账簿放在一起，而不是散落在便签和抽屉里。"
          }
        }
      }
    },
