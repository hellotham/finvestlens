          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "領収書と書類"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Recibos e documentos"
          }
        },
        "zh-Hans": {
