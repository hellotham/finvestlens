    "Start with a ready-made personal chart of accounts — cheque, savings, credit card, income and common expense categories — or begin from scratch.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Beginnen Sie mit einem fertigen privaten Kontenplan — Giro, Sparen, Kreditkarte, Einnahmen und gängige Ausgabenkategorien — oder fangen Sie bei null an."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Empieza con un plan de cuentas personal ya preparado —cuenta corriente, ahorro, tarjeta de crédito, ingresos y categorías de gasto habituales— o parte de cero."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Démarrez avec un plan comptable personnel prêt à l’emploi — compte courant, épargne, carte de crédit, revenus et catégories de dépenses courantes — ou partez de zéro."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Inizia con un piano dei conti personale già pronto — conto corrente, risparmio, carta di credito, entrate e categorie di spesa comuni — oppure parti da zero."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "すぐ使える個人向け勘定科目表（当座・貯蓄・クレジットカード・収入・主な費用区分）から始めるか、ゼロから作成します。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Comece com um plano de contas pessoal pronto — conta corrente, poupança, cartão de crédito, receitas e categorias de despesa comuns — ou do zero."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "可使用现成的个人会计科目表 — 支票、储蓄、信用卡、收入及常见费用类别 — 或从零开始。"
          }
        }
      }
    },
