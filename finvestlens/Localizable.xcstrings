          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Edita el presupuesto para fijar importes en tus cuentas de gastos."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Modifiez le budget pour définir les montants de vos comptes de charges."
          }
        },
        "it": {
