    "Derived from the earliest transaction — the book records no opening date.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Abgeleitet aus der frühesten Buchung — das Buch führt kein Eröffnungsdatum."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Derivado de la transacción más antigua: el libro no registra una fecha de apertura."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Déduit de la transaction la plus ancienne — le livre n’enregistre pas de date d’ouverture."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Ricavato dalla transazione più remota: il libro non registra una data di apertura."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "最も古い取引から導いた日付です。帳簿は開設日を記録しません。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
