    "Matches each one to a transaction already in your book, in any account.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ordnet jede einer Buchung zu, die bereits in Ihrem Buch steht — in jedem Konto."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Empareja cada una con una transacción que ya está en tu libro, en cualquier cuenta."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Associe chacune à une opération déjà présente dans votre livre, dans n’importe quel compte."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Abbina ciascuna a una transazione già presente nel libro, in qualsiasi conto."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "それぞれを、帳簿内のいずれかの勘定科目にある既存の取引と照合します。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
