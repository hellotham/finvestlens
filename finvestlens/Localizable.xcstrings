    "⌘Z undoes anything, including an import.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "⌘Z widerruft alles, auch einen Import."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "⌘Z deshace cualquier cosa, incluida una importación."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "⌘Z annule tout, y compris un import."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "⌘Z annulla qualsiasi cosa, importazione compresa."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "⌘Z は読み込みを含め、あらゆる操作を取り消します。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "⌘Z desfaz qualquer coisa, inclusive uma importação."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "⌘Z 可撤销任何操作，包括导入。"
          }
        }
      }
