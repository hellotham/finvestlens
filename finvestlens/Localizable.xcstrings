            "state": "translated",
            "value": "Prévoyez ce que vous comptez dépenser, puis voyez ce qu’il en a été."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Pianifica quanto intendi spendere, poi guarda com’è andata."
          }
