            "value": "%lld 笔交易"
          }
        }
      }
    },
    "%lld transactions found — review to import and reconcile.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld Buchungen gefunden — prüfen, um zu importieren und abzugleichen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
