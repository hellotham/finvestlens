    "Keep key details — insurance policies, account numbers, contacts — with the book, for when they're needed in a hurry.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wichtige Angaben — Versicherungspolicen, Kontonummern, Kontakte — beim Buch aufbewahren, für den Fall der Fälle."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Guarda los datos clave —pólizas de seguro, números de cuenta, contactos— junto al libro, para cuando hagan falta con urgencia."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Conservez les informations essentielles — polices d’assurance, numéros de compte, contacts — avec le livre, pour les retrouver en cas d’urgence."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Conserva le informazioni essenziali — polizze assicurative, numeri di conto, contatti — insieme al libro, per quando servono in fretta."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "保険証券、口座番号、連絡先などの重要情報を帳簿と一緒に保管し、いざというときにすぐ使えるようにします。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Guarde informações essenciais — apólices de seguro, números de conta, contatos — junto ao livro, para quando forem necessárias com urgência."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "将关键信息 — 保单、账号、联系人 — 与账簿放在一起，以备急需。"
          }
        }
      }
    },
