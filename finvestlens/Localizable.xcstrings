    "Post it — that books the amount to accounts receivable.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Buchen Sie sie — damit wandert der Betrag auf die Forderungen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Contabilízala: eso lleva el importe a clientes por cobrar."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Comptabilisez-la — le montant est porté aux créances clients."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Registrala: l’importo va nei crediti verso clienti."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "記帳します — 金額が売掛金に計上されます。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Lance-a — isso registra o valor em contas a receber."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "过账 — 金额将计入应收账款。"
          }
        }
      }
    },
    "Post it. Undo takes the whole closing back in one step; a book with more than one currency gets one closing entry per currency.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Buchen Sie ab. Widerrufen nimmt den ganzen Abschluss in einem Schritt zurück; ein Buch mit mehr als einer Währung erhält je Währung eine Abschlussbuchung."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Regístrelo. Deshacer revierte todo el cierre en un solo paso; un libro con más de una divisa recibe un asiento de cierre por divisa."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Validez. Annuler défait la clôture entière en une seule fois ; un livre à plusieurs devises reçoit une écriture de clôture par devise."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Registratelo. Annulla riporta indietro l’intera chiusura in un solo passo; un libro con più di una valuta riceve una scrittura di chiusura per ciascuna valuta."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "記帳します。取り消しは締め処理全体を一度に戻します。通貨が複数ある帳簿では、通貨ごとに 1 本ずつ締めの仕訳が立ちます。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Lance. Desfazer reverte o encerramento inteiro num único passo; um livro com mais de uma moeda recebe um lançamento de encerramento por moeda."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "过账。撤销可以一步把整个结转退回；含有多种货币的账簿，每种货币会生成一笔结转分录。"
          }
        }
      }
    },
    "Post unmatched rows to the imbalance account": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Nicht zugeordnete Zeilen auf das Ausgleichskonto buchen"
