    "Used to match this security at providers that key by identifier rather than ticker.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dient dazu, dieses Wertpapier bei Anbietern zu finden, die nach Kennung statt nach Kürzel suchen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Sirve para localizar este valor en proveedores que buscan por identificador en lugar de por ticker."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sert à retrouver ce titre chez les fournisseurs qui indexent par identifiant plutôt que par symbole."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Serve a trovare questo titolo presso i fornitori che indicizzano per identificativo anziché per ticker."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ティッカーではなく識別子で検索するプロバイダで、この証券を照合するために使われます。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Serve para localizar este título em provedores que indexam por identificador em vez de ticker."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "用于在按标识符（而非代码）检索的提供方处匹配此证券。"
          }
        }
      }
    },
