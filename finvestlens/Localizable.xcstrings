      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Öffnet einen Dateidialog — die gewählte Datei wird an Ort und Stelle verknüpft, relativ zum Dokumentordner (Einstellungen ▸ Dokumente), sofern sie darin liegt"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Abre un diálogo de archivos: el archivo elegido se vincula en su sitio, guardado de forma relativa a la carpeta del documento (Ajustes ▸ Documentos) si está dentro"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
