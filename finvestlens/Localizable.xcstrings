    "Learned from an existing transaction with the same description, including its split breakdown (e.g. salary or dividend components).": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Aus einer vorhandenen Buchung mit derselben Beschreibung gelernt, einschließlich ihrer Aufteilung (z. B. Gehalts- oder Dividendenbestandteile)."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Aprendido de una transacción existente con la misma descripción, incluido su desglose (p. ej. componentes de nómina o dividendos)."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Appris d’une opération existante portant le même libellé, y compris sa ventilation (p. ex. composantes de salaire ou de dividende)."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Appreso da una transazione esistente con la stessa descrizione, inclusa la sua suddivisione (es. componenti di stipendio o dividendo)."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "同じ摘要の既存取引から学習しました（給与や配当の内訳などのスプリット構成を含む）。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Aprendido de uma transação existente com a mesma descrição, incluindo sua divisão (ex.: componentes de salário ou dividendos)."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
