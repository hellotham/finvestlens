            "state": "translated",
            "value": "提供方拒绝了该请求（HTTP %lld）。"
          }
        }
      }
    },
    "The provider's reply was not in the expected form.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Antwort des Anbieters hatte nicht die erwartete Form."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
