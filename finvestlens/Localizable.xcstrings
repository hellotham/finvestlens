    "Opened with %@ unreadable and defaulted — consider Repair Book and check the audit trail.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Beim Öffnen waren %@ unlesbar und wurden auf Standardwerte gesetzt – „Buch reparieren“ erwägen und den Prüfpfad ansehen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Al abrir, %@ resultaron ilegibles y se establecieron valores predeterminados: considere Reparar libro y revise la pista de auditoría."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "À l’ouverture, %@ étaient illisibles et ont reçu des valeurs par défaut – envisagez Réparer le livre et consultez la piste d’audit."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "All’apertura %@ non erano leggibili e sono stati impostati valori predefiniti: valuta Ripara libro e controlla la pista di controllo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "開いた際に %@ が読み取れず、既定値が設定されました。「帳簿を修復」を検討し、監査証跡を確認してください。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Ao abrir, %@ estavam ilegíveis e receberam valores padrão — considere Reparar livro e verifique a trilha de auditoria."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "打开时有 %@ 无法读取并已使用默认值 — 建议执行“修复账簿”并查看审计记录。"
          }
        }
      }
    },
