          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Haz que una programación se cree unos días antes si prefieres verla venir."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Faites créer une planification quelques jours à l’avance si vous aimez la voir arriver."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Fai creare una pianificazione qualche giorno prima, se preferisci vederla arrivare."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "予定を数日前に作成するよう設定すれば、前もって把握できます。"
          }
        },
        "pt-BR": {
