    "Enter the statement's closing balance and date — FinvestLens auto-clears the matching transactions and shows any difference left to chase.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Geben Sie Schlusssaldo und Datum des Auszugs ein — FinvestLens bestätigt die passenden Buchungen automatisch und zeigt eine verbleibende Differenz."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Introduce el saldo final y la fecha del extracto: FinvestLens confirma automáticamente las transacciones coincidentes y muestra la diferencia pendiente."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Saisissez le solde de clôture et la date du relevé — FinvestLens pointe automatiquement les opérations correspondantes et affiche l’écart restant."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Inserisci il saldo finale e la data dell’estratto conto: FinvestLens compensa automaticamente le transazioni corrispondenti e mostra l’eventuale differenza residua."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "明細の期末残高と日付を入力すると、FinvestLens が一致する取引を自動で清算済みにし、残った差額を表示します。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Informe o saldo final e a data do extrato — o FinvestLens compensa automaticamente as transações correspondentes e mostra a diferença restante."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "输入对账单的期末余额与日期 — FinvestLens 会自动结清匹配的交易，并显示尚待核查的差额。"
          }
        }
      }
    },
    "Enter the statement's closing balance and date.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
