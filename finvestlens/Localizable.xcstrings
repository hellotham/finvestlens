    "Move no money — typically “Opening Balance” stubs GnuCash leaves for accounts created without a balance. Cleaning removes them.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Move no money — typically “Opening Balance” stubs GnuCash leaves for accounts created without a balance. Cleaning removes them."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Bewegen kein Geld — typischerweise „Anfangsbestand“-Reste, die GnuCash für ohne Saldo angelegte Konten hinterlässt. Beim Bereinigen werden sie entfernt."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No mueven dinero: normalmente restos de «Saldo inicial» que GnuCash deja en cuentas creadas sin saldo. La limpieza los elimina."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ne déplacent aucun montant — généralement des résidus « Solde initial » laissés par GnuCash pour des comptes créés sans solde. Le nettoyage les supprime."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Non movimentano denaro: di norma residui di «Saldo iniziale» che GnuCash lascia per i conti creati senza saldo. La pulizia li rimuove."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "金額が動きません。残高なしで作成した勘定に GnuCash が残す「開始残高」の名残であることがほとんどです。整理すると削除されます。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Não movimentam dinheiro — normalmente restos de “Saldo inicial” que o GnuCash deixa em contas criadas sem saldo. A limpeza os remove."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "没有金额变动——通常是 GnuCash 为没有余额的账户留下的“期初余额”残留。清理会删除它们。"
          }
        }
      }
    },
