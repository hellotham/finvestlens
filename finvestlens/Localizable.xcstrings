    "Prepared with FinvestLens from the owner's own records — a snapshot, not a verified statement.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Mit FinvestLens aus den eigenen Aufzeichnungen des Inhabers erstellt — eine Momentaufnahme, kein geprüfter Abschluss."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Elaborado con FinvestLens a partir de los propios registros del titular: una instantánea, no un estado verificado."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Établi avec FinvestLens à partir des propres écritures du titulaire — un instantané, non un état vérifié."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Redatto con FinvestLens dalle registrazioni del titolare: un’istantanea, non un bilancio verificato."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "FinvestLens により所有者自身の記録から作成されました。検証済みの財務諸表ではなく、ある時点のスナップショットです。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Elaborado com o FinvestLens a partir dos próprios registros do titular — um retrato, não uma demonstração auditada."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "由 FinvestLens 依据所有者自己的记录生成 — 这是一份快照，而非经审核的报表。"
          }
        }
      }
    },
