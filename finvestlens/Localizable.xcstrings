    "What you owe — credit cards, loans, mortgages.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Was Sie schulden — Kreditkarten, Darlehen, Hypotheken."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Lo que debes: tarjetas de crédito, préstamos, hipotecas."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ce que vous devez — cartes de crédit, prêts, crédits immobiliers."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
