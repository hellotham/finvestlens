    "Set the closing date and pick the equity account to close into — Retained Earnings, typically.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Legen Sie das Abschlussdatum fest und wählen Sie das Eigenkapitalkonto, in das abgeschlossen wird — meist Gewinnvortrag."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Fije la fecha de cierre y elija la cuenta de patrimonio a la que cerrar: normalmente Ganancias retenidas."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Fixez la date de clôture et choisissez le compte de capitaux propres de destination — le report à nouveau, en général."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Impostate la data di chiusura e scegliete il conto di patrimonio netto su cui chiudere — di solito Utili portati a nuovo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "締め日を設定し、振替先の純資産勘定を選びます。通常は繰越利益です。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Defina a data de encerramento e escolha a conta de patrimônio para onde encerrar — normalmente Lucros acumulados."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
