        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld alteraç%@ aplicada."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "已应用 %lld 项更改%@。"
          }
        }
      }
    },
    "Applies to every date shown in the app. Compact tables use the short form, labels and documents spell out the month, and headline dates include the weekday — always in your chosen order.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Gilt für jedes im Programm angezeigte Datum. Kompakte Tabellen nutzen die Kurzform, Beschriftungen und Dokumente schreiben den Monat aus, und Überschriftsdaten enthalten den Wochentag — stets in Ihrer gewählten Reihenfolge."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se aplica a todas las fechas que muestra la app. Las tablas compactas usan el formato corto, las etiquetas y los documentos escriben el mes con letras y las fechas destacadas incluyen el día de la semana, siempre en el orden que elijas."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "S’applique à toutes les dates affichées dans l’app. Les tableaux compacts utilisent la forme courte, les libellés et documents écrivent le mois en toutes lettres, et les dates de titre incluent le jour de la semaine — toujours dans l’ordre que vous avez choisi."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Vale per ogni data mostrata nell’app. Le tabelle compatte usano la forma breve, etichette e documenti scrivono il mese per esteso e le date in evidenza includono il giorno della settimana, sempre nell’ordine scelto."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "アプリに表示されるすべての日付に適用されます。コンパクトな表は短い形式、ラベルや書類は月名を綴り、見出しの日付は曜日を含みます。順序は常にあなたの選択どおりです。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Aplica-se a todas as datas exibidas no app. Tabelas compactas usam o formato curto, rótulos e documentos escrevem o mês por extenso e datas de destaque incluem o dia da semana — sempre na ordem escolhida."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "适用于 App 中显示的所有日期。紧凑表格使用简短形式，标签与文稿会写出月份全称，标题日期包含星期 — 始终按你选择的顺序。"
          }
        }
      }
    },
    "Applies to the %lld simple transfer%@ — multi-split, security and multi-currency transactions are left unchanged.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Gilt für die %lld einfache%@ Umbuchung%@ — Buchungen mit mehreren Teilen, Wertpapieren oder Währungen bleiben unverändert."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se aplica a %lld transferencia%@ simple%@: las transacciones con varios desgloses, valores o divisas no se modifican."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "S’applique aux %lld virement%@ simple%@ — les opérations multi-répartitions, sur titres et multidevises restent inchangées."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Si applica a %lld giroconto%@ semplice%@: le transazioni con più suddivisioni, su titoli o multivaluta restano invariate."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld 件の単純な振替%@に適用されます。複数スプリット・証券・複数通貨の取引は変更されません。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Aplica-se a %lld transferência%@ simples: transações com múltiplas divisões, títulos ou moedas não são alteradas."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "适用于 %lld 笔简单转账%@ — 多分录、证券及多币种交易保持不变。"
          }
        }
      }
    },
