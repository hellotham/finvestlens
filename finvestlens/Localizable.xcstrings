    "Transactions in a foreign currency, or with more than two splits, are edited in the inspector rather than inline — the register row shows a reminder when that applies.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Buchungen in Fremdwährung oder mit mehr als zwei Buchungsteilen werden im Informationsbereich statt direkt in der Zeile bearbeitet — die Kontobuchzeile weist darauf hin."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las transacciones en divisa extranjera, o con más de dos desgloses, se editan en el inspector en lugar de en línea: la fila del libro te lo recuerda cuando aplica."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les opérations en devise étrangère, ou comportant plus de deux répartitions, se modifient dans l’inspecteur plutôt qu’en ligne — la ligne du registre le rappelle le cas échéant."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Le transazioni in valuta estera, o con più di due suddivisioni, si modificano nell’ispettore invece che in linea: la riga del libro mastro lo ricorda quando serve."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "外貨建ての取引や、スプリットが 3 つ以上ある取引は、行内ではなくインスペクタで編集します。該当する場合は記入帳の行にその旨が表示されます。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Transações em moeda estrangeira, ou com mais de duas divisões, são editadas no inspetor em vez de na linha — a linha do razão avisa quando é o caso."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "外币交易，或分录超过两条的交易，需在检查器中编辑而非行内编辑 — 遇到这种情况时流水账行会给出提示。"
          }
        }
      }
    },
