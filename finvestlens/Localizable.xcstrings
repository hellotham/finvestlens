    "Existing prices for the selected securities are replaced with a freshly fetched series. If a fetch fails, that security keeps its current prices.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Vorhandene Kurse der ausgewählten Wertpapiere werden durch eine neu abgerufene Reihe ersetzt. Schlägt ein Abruf fehl, behält das Wertpapier seine bisherigen Kurse."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las cotizaciones actuales de los valores seleccionados se sustituyen por una serie recién descargada. Si la descarga falla, ese valor conserva sus cotizaciones."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les cours existants des titres sélectionnés sont remplacés par une série fraîchement récupérée. En cas d’échec, le titre conserve ses cours actuels."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Le quotazioni esistenti dei titoli selezionati vengono sostituite con una serie appena scaricata. Se il download non riesce, il titolo mantiene le quotazioni attuali."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "選択した証券の既存価格は、新たに取得した系列に置き換えられます。取得に失敗した証券は現在の価格を保持します。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "As cotações existentes dos títulos selecionados são substituídas por uma série recém-obtida. Se a busca falhar, o título mantém as cotações atuais."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "所选证券的现有价格将被新获取的序列替换。若获取失败，该证券保留当前价格。"
          }
        }
      }
    },
