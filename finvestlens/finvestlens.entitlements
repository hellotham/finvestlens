<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!--
	  FinvestLens app entitlements. App Sandbox is ON (11 Oct 2026, for the
	  Mac App Store and TestFlight, which require it): the book and anything
	  the person picks come in through the open/save panels and app-scoped
	  bookmarks, the sibling `.lock` and `.audit` files beside a book are
	  reached as *related items* of the document (declared in Info.plist and
	  accessed through a file coordinator carrying the document as the
	  primary item), and the price providers and Box need outgoing network.
	  The bundle ID is com.hellotham.finvestlens; the App Group and iCloud
	  container below deliberately keep the older …finvestlensapp base. They
	  are separately registered identifiers that already hold this team's
	  data, so renaming them is a portal change in its own right (see
	  docs/provisioning.md), not part of the bundle-ID rename.
	-->
	<key>com.apple.security.app-sandbox</key>
	<true/>
	<key>com.apple.security.files.user-selected.read-write</key>
	<true/>
	<key>com.apple.security.files.bookmarks.app-scope</key>
	<true/>
	<key>com.apple.security.network.client</key>
	<true/>

	<!-- App Group: shared container the app writes widget/Quick Look snapshots
	     into (the extensions read from it). -->
	<key>com.apple.security.application-groups</key>
	<array>
		<string>group.com.hellotham.finvestlensapp</string>
	</array>

	<!-- iCloud Documents (FR-PLT-02): the app's Documents surface in iCloud
	     Drive so a .finvestlens book syncs file-level across devices. -->
	<key>com.apple.developer.icloud-container-identifiers</key>
	<array>
		<string>iCloud.com.hellotham.finvestlensapp</string>
	</array>
	<key>com.apple.developer.ubiquity-container-identifiers</key>
	<array>
		<string>iCloud.com.hellotham.finvestlensapp</string>
	</array>
	<key>com.apple.developer.icloud-services</key>
	<array>
		<string>CloudDocuments</string>
	</array>

	<!-- Private Cloud Compute (FR-AI-13): Apple's managed capability "Access to
	     models on Private Cloud Compute", granted to this App ID on 17 Oct 2026.
	     Lands only with the PRIVATE_CLOUD_COMPUTE build condition, the help and
	     the privacy policy (PrivateCloudComputeBuildTests). Apple provisions it
	     for Development, Ad hoc and App Store Connect, not Developer ID, so the
	     DMG is signed with finvestlens-DeveloperID.entitlements, which is this
	     file without this key. -->
	<key>com.apple.developer.private-cloud-compute</key>
	<true/>
</dict>
</plist>
