---
import Base from '../layouts/Base.astro';
import PageHeader from '../components/PageHeader.astro';
import { site, release, url } from '../data/site';
import manual from '../data/manual.json';

// Counted from the generated book so the number cannot go stale.
const topicCount = manual.sections.reduce((n, s) => n + s.topics.length, 0);

const faqs = [
  {
    q: 'Can I move my GnuCash book across?',
    a: 'Yes, on a Mac. File ▸ Import GnuCash… reads your .gnucash file — accounts, transactions, prices, scheduled transactions and business records — and the book it makes opens on your iPhone and iPad too. You can export back to GnuCash XML at any time, and the round trip is verified byte-identical.',
  },
  {
    q: 'Where is my data stored?',
    a: 'In one .finvestlens file wherever you put it — local disk, iCloud Drive, a NAS or your own Box account. There is no FinvestLens account and no server of ours. Back it up like any other document.',
  },
  {
    q: 'Can two people use the same book?',
    a: 'Not simultaneously. A book on a shared drive is locked by whichever device has it open, with a heartbeat so a crashed session does not lock you out permanently. If the lock is stale you can break it and open anyway.',
  },
  {
    q: 'Does it work offline?',
    a: 'Yes. The app goes online only when you ask it to: for price quotes, the consumer price index, your own Box account or, if you allow it, Apple’s Private Cloud Compute. The privacy policy lists each.',
  },
  {
    q: 'Should I use the App Store or the disk image on a Mac?',
    a: 'Either: they are the same version from the same source. The App Store version updates itself and can use Apple’s Private Cloud Compute if you allow it. The disk image cannot, because Apple does not offer that to apps distributed outside the App Store, and you download new versions yourself. The download page sets out the difference.',
  },
  {
    q: 'Why does macOS not warn me when I open it?',
    a: 'Because Apple has checked it: through App Review on the App Store, and by notarization for the disk image, which is also signed with a Developer ID. You can verify the disk image yourself — the commands are on the download page.',
  },
  {
    q: 'Is there an iPhone or iPad version?',
    a: 'Yes, on the App Store: one free download for Mac, iPhone and iPad. On iPhone, FinvestLens opens, creates and edits books. Bank files are imported on iPad or Mac, and a GnuCash file or Ledger journal on a Mac.',
  },
];
---

<Base
  title="Support"
  description="Get help with FinvestLens — documentation, frequently asked questions, and how to report a bug."
>
  <PageHeader eyebrow="Support" title="Help and support" lead="Start with the manual; if that does not answer it, get in touch." />

  <div class="mx-auto max-w-3xl px-5 py-16">
    <div class="grid gap-4 sm:grid-cols-3">
      <a href={url('/manual/')} class="rounded-xl border border-ink-200 p-5 transition-colors hover:border-brand-300 dark:border-ink-800">
        <h2 class="font-semibold text-ink-900 dark:text-white">User manual</h2>
        <p class="mt-1 text-sm text-ink-600 dark:text-ink-400">{topicCount} topics, also in the app under Help.</p>
      </a>
      <a href={site.contact.issues} class="rounded-xl border border-ink-200 p-5 transition-colors hover:border-brand-300 dark:border-ink-800">
        <h2 class="font-semibold text-ink-900 dark:text-white">Report a bug</h2>
        <p class="mt-1 text-sm text-ink-600 dark:text-ink-400">Open an issue on GitHub.</p>
      </a>
      <a href={`mailto:${site.contact.email}`} class="rounded-xl border border-ink-200 p-5 transition-colors hover:border-brand-300 dark:border-ink-800">
        <h2 class="font-semibold text-ink-900 dark:text-white">Email us</h2>
        <p class="mt-1 text-sm break-all text-ink-600 dark:text-ink-400">{site.contact.email}</p>
      </a>
    </div>

    <div class="prose-doc mt-14">
      <h2>Frequently asked</h2>
      {faqs.map((f) => (
        <div class="mt-8">
          <h3>{f.q}</h3>
          <p>{f.a}</p>
        </div>
      ))}

      <h2>Reporting a problem</h2>
      <p>
        The most useful report says what you did, what happened, and what you
        expected instead. Please include the app version and your system version.
        The current release is {release.version}.
      </p>
      <p>
        <strong>Please do not attach your book file</strong> — it contains your
        finances. If a specific transaction or account is involved, describe its
        shape rather than sending the data.
      </p>

      <h2>Something wrong with a number?</h2>
      <p>
        Correctness reports are taken seriously. FinvestLens is checked against
        GnuCash on a real 46,000-transaction book, so if a balance or report
        disagrees with what you expect, that is worth telling us about — say which
        report, which account and which period, and what figure you expected.
      </p>
    </div>
  </div>
</Base>
