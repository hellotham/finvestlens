---
import { site, footerNav, url } from '../data/site';
const year = 2026;
---

<footer class="mt-24 border-t border-ink-200 bg-ink-50 dark:border-ink-800 dark:bg-ink-900/50">
  <div class="mx-auto max-w-6xl px-5 py-14">
    <div class="grid gap-10 sm:grid-cols-2 lg:grid-cols-5">
      <div class="lg:col-span-2">
        <div class="flex items-center gap-2.5">
          <img src={url('/images/icon-64.png')} alt="" width="32" height="32" class="" />
          <span class="font-semibold tracking-tight text-ink-900 dark:text-white">{site.name}</span>
        </div>
        <p class="mt-3 max-w-xs text-sm leading-relaxed text-ink-500 dark:text-ink-400">
          {site.description}
        </p>
        <p class="mt-4 text-sm text-ink-500 dark:text-ink-400">
          Published by <a
            href={site.publisher.url}
            class="font-medium text-ink-700 underline decoration-ink-300 underline-offset-2 hover:text-brand-600 dark:text-ink-200"
            >{site.publisher.name}</a
          >
        </p>
      </div>

      {
        footerNav.map((group) => (
          <div>
            <h2 class="text-xs font-semibold tracking-wider text-ink-400 uppercase">{group.heading}</h2>
            <ul class="mt-3 space-y-2 text-sm">
              {group.links.map((link) => (
                <li>
                  <a
                    href={url(link.href)}
                    class="text-ink-600 hover:text-brand-600 dark:text-ink-400 dark:hover:text-brand-300"
                  >
                    {link.label}
                  </a>
                </li>
              ))}
            </ul>
          </div>
        ))
      }
    </div>

    <div
      class="mt-12 flex flex-col gap-3 border-t border-ink-200 pt-6 text-sm text-ink-500 sm:flex-row sm:items-center sm:justify-between dark:border-ink-800 dark:text-ink-400"
    >
      <p>© {year} {site.publisher.legalName}. Free software under the GNU GPL v3.0.</p>
      <div class="flex gap-5">
        <a href={site.repo} class="hover:text-brand-600 dark:hover:text-brand-300">Source</a>
        <a href={site.publisher.url} class="hover:text-brand-600 dark:hover:text-brand-300"
          >hellotham.com</a
        >
      </div>
    </div>
  </div>
</footer>
