---
interface Props { eyebrow?: string; title: string; lead?: string; }
const { eyebrow, title, lead } = Astro.props;
---
<div class="border-b border-ink-200 bg-ink-50/60 dark:border-ink-800 dark:bg-ink-900/30">
  <div class="mx-auto max-w-6xl px-5 py-14 sm:py-16">
    {eyebrow && (
      <p class="text-sm font-semibold tracking-wider text-brand-600 uppercase dark:text-brand-400">
        {eyebrow}
      </p>
    )}
    <h1 class="mt-2 text-4xl font-bold tracking-tight text-ink-900 sm:text-5xl dark:text-white">
      {title}
    </h1>
    {lead && (
      <p class="mt-4 max-w-2xl text-lg leading-relaxed text-ink-600 dark:text-ink-300">{lead}</p>
    )}
  </div>
</div>
